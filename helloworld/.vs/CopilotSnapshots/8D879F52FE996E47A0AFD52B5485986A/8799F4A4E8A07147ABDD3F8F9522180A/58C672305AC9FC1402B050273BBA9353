#include<stdio.h>
#include<stdlib.h>
int main()
{
	int* p = malloc(10 * sizeof(int));
	// 动态内存分配后，p指向的内存空间可以存储10个int类型的整数
	//第一种赋值方式
	for (int i = 0; i < 10; i++)
	{
		*(p + i) = i;
	}
	//for (int i = 0; i < 10; i++)
	//{
	//	printf("%d ", *(p + i));
	//}
	


	//int *p = calloc(10, sizeof(int));

	//for (int i = 0; i < 10; i++)
	//{
	//	printf("%d ", *(p + i));
	//}

	// realloc 可能移动内存块：成功时原指针 p 已失效，
	// 必须改为操作返回的新指针，避免悬空指针和重复释放
	int *pp = realloc(p, 20 * sizeof(int));
	if (pp == NULL)
	{
		// 扩展失败时 p 仍然有效，由 p 负责释放
		free(p);
		return 1;
	}
	p = pp;   // 后续统一使用 p
	pp = NULL;

	// realloc 新扩展的 10 个 int 是未初始化的，先赋值再使用
	for (int i = 10; i < 20; i++)
	{
		p[i] = i;
	}

	for (int i = 0; i < 20; i++)
	{
		printf("%d\n", p[i]);
	}

	free(p);   // 只释放一次
	return 0;

}